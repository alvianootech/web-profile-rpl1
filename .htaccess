RewriteEngine On

# 1. Cegah loop jika request sudah diproses secara internal
RewriteCond %{ENV:REDIRECT_STATUS} 200
RewriteRule ^ - [L]

# 2. Redirect jika browser mengakses index.php atau /index langsung
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*?/)?index(?:\.php)?[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# 3. Redirect browser yang mengakses *.php langsung ke versi tanpa .php
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*?)\.php[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# 4. Jika ada file atau folder fisik nyata (css, js, gambar), jangan di-rewrite
RewriteCond %{REQUEST_FILENAME} -d [OR]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 5. Ambil file .php internal jika file fisiknya ada
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ $1.php [L]
